---
/**
 * ./src/pages/[locale]/404.astro
 * 404ページ
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, locales, type Locale } from '@lib/i18n';
import { getWikiBaseUrl } from '@lib/path';
import MainLayout from '@layouts/MainLayout.astro';

export const getStaticPaths = () => {
    return locales.map((locale) => ({
        params: { locale },
        props: { locale },
    }));
};

interface Props {
    locale: Locale;
}

const { locale } = Astro.props as Props;

const alternateLinks = locales.map((loc) => ({
    locale: loc,
    href: getRelativeLocaleUrl(loc, '/404'),
}));
---
<MainLayout
    title={t('404.title', locale)}
    description={t('404.description', locale)}
    locale={locale}
    type="other"
    alternateLinks={alternateLinks}
    showSubpanel={false}
    noindex
>
    <p>{t('404.description', locale)}</p>
    <p><a href={getWikiBaseUrl(locale)}>{t('homepage.title', locale)}</a></p>
</MainLayout>