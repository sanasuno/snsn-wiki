---
/**
 * ./src/pages/[locale]/tag/[tag].astro
 * タグページ
 */
import { t, locales, type Locale } from '@lib/i18n';
import { getTagUrl } from '@lib/path';
import { getPublishedWikiPages } from '@lib/pages';
import MainLayout from '@layouts/MainLayout.astro';
import ListPageItem from '@layouts/ListPageItem.astro';
import { getTagMap } from '@lib/tags';

export async function getStaticPaths() {
    const wikiPages = await getPublishedWikiPages();
    return locales.flatMap((locale) =>
        [...getTagMap(wikiPages, locale).keys()].map((tag) => ({
            params: { locale, tag },
            props: { locale, tag },
        }))
    );
}

interface Props {
    locale: Locale;
    tag: string;
}

const { locale, tag } = Astro.props as Props;

const wikiPages = await getPublishedWikiPages();
const sortedPages = [...(getTagMap(wikiPages, locale).get(tag) ?? [])]
    .sort((a, b) => a.data.title.localeCompare(b.data.title, locale));

const alternateLinks = locales
    .filter((loc) => getTagMap(wikiPages, loc).has(tag))
    .map((loc) => ({ locale: loc, href: getTagUrl(loc, tag) }));
---
<MainLayout
    title={tag}
    description={t('tagpage.description', locale)}
    locale={locale}
    alternateLinks={alternateLinks}
    type="tag"
    showSubpanel={false}
    isSubpage={true}
>
    <div class="listpage-header">
        <div class="listpage-counter">
            {sortedPages.length} {t('count.pages', locale)}
        </div>
    </div>
    <div class="listpage-content">
        <ul class="listpage-item-list">
            {sortedPages.map((page) => <ListPageItem page={page} locale={locale} /> )}
        </ul>
    </div>
</MainLayout>
