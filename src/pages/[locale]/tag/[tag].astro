---
/**
 * ./src/pages/[locale]/tag/[tag].astro
 * タグページ
 */
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, locales, type Locale } from '@lib/i18n';
import { getLocaleBaseUrl, getWikiUrl, ensureTrailingSlash } from '@lib/path';
import { getUniquePagesByLocale } from '@lib/pages';
import { formatDate } from '@lib/date';
import MainLayout from '@layouts/MainLayout.astro';

export async function getStaticPaths() {
    const pages = await getCollection('wiki', (p) => !p.data.draft);
    const tagMap: Record<string, typeof pages> = {};
    for (const page of pages) {
        for (const tag of page.data.tags) {
            if (!tagMap[tag]) {
                tagMap[tag] = [];
            }
            tagMap[tag].push(page);
        }
    }
    const paths: { params: { locale: Locale; tag: string }; props: { locale: Locale; tag: string; } }[] = [];
    for (const locale of locales) {
        for (const [tag, pages] of Object.entries(tagMap)) {
            paths.push({
                params: {
                    locale,
                    tag,
                },
                props: {
                    locale,
                    tag,
                },
            });
        }
    }
    return paths;
}

interface Props {
    locale: Locale;
    tag: string;
}

const { locale, tag } = Astro.props as Props;

const localeBaseUrl = getLocaleBaseUrl(locale);

const wikiPages = await getCollection('wiki', (p) => !p.data.draft);
const tagPages = getUniquePagesByLocale(wikiPages, locale).filter((page) => page.data.tags.includes(tag));
const sortedPages = [...tagPages].sort((a, b) =>
    (a.data.title.localeCompare(b.data.title, locale))
);

const alternateLinks = locales.map((loc) => ({
    locale: loc,
    href: getRelativeLocaleUrl(loc, `tag/${tag}`),
}))
---
<MainLayout
    title={tag}
    description={t('tagpage.description', locale)}
    locale={locale}
    alternateLinks={alternateLinks}
    type="tag"
    showSubpanel={false}
    isSubpage={true}
>
    <div class="listpage-header">
        <div class="listpage-counter">
            {sortedPages.length} {t('count.pages', locale)}
        </div>
    </div>
    <div class="listpage-content">
        <ul class="listpage-item-list">
            {sortedPages.map((page) => {
                const updated = page.data.updated ?? page.data.date ?? new Date(0);
                const isUpdated = !!page.data.updated;
                return (
                    <li class="listpage-item">
                        <div class="listpage-item-left">
                            <div class="listpage-item-content">
                                <a href={getWikiUrl(page.id, locale)} class="listpage-item-title">
                                    <i class="fa-regular fa-file-lines"></i>
                                    {page.data.title}
                                </a>
                                {page.data.tags && (
                                    <div class="listpage-item-tags">
                                        {page.data.tags.map((tag) => (
                                            <a href={ensureTrailingSlash(`${localeBaseUrl}tag/${tag}`)} class="listpage-item-tag">
                                                #{tag}
                                            </a>
                                        ))}
                                    </div>
                                )}
                            </div>
                            {page.data.description && (
                                <p class="listpage-item-description">
                                    {page.data.description}
                                </p>
                            )}
                        </div>
                        <div class="listpage-item-right">
                            <p class="listpage-item-updated">
                                <i class={`${isUpdated ? 'fas fa-clock-rotate-left' : 'far fa-calendar-plus'}`} aria-hidden="true"></i>
                                {formatDate(updated, locale)}
                            </p>
                        </div>
                    </li>
                );
            })}
        </ul>
    </div>
</MainLayout>
