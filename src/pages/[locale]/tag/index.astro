---
/**
 * ./src/pages/[locale]/tag/index.astro
 * タグ一覧ページ
 */
import { getCollection } from 'astro:content';
import { t, locales, type Locale } from '@lib/i18n';
import { getTagUrl, getLocalePathUrl } from '@lib/path';
import { getTagMap } from '@lib/tags';
import { getPublishedWikiPages } from '@lib/pages';
import MainLayout from '@layouts/MainLayout.astro';
import ListPageItem from '@layouts/ListPageItem.astro';

export const getStaticPaths = () => {
    return locales.map((locale) => ({
        params: { locale },
        props: { locale },
    }));
};

const { locale } = Astro.props as { locale: Locale };

const wikiPages = await getPublishedWikiPages();
const tagMap = getTagMap(wikiPages, locale);
const sortedTags = [...tagMap].sort(([a], [b]) => a.localeCompare(b, locale));

const alternateLinks = locales.map((loc) => ({
    locale: loc,
    href: getLocalePathUrl(loc, 'tag'),
}));
---
<MainLayout
    title={t('tagpage.title', locale)}
    description={t('tagpage.description', locale)}
    locale={locale}
    type="tag"
    showSubpanel={false}
    alternateLinks={alternateLinks}
>
    <div class="listpage-header">
        <div class="listpage-counter">
            {tagMap.size} {t('count.tags', locale)}
        </div>
    </div>
    <div class="listpage-content">
        <ul class="listpage-list">
            {sortedTags.map(([tag, pages]) => {
                return (
                    <li class="listpage-section">
                        <div class="listpage-section-header">
                            <a href={getTagUrl(locale, tag)} class="listpage-section-title">
                                <h3>#{tag}</h3>
                            </a>
                            <div class="listpage-section-count">
                                {pages.length} {t('count.pages', locale)}
                            </div>
                        </div>
                        <ul class="listpage-item-list">
                            {pages.map((page) => <ListPageItem page={page} locale={locale} /> )}
                        </ul>
                    </li>
                )
            })}
        </ul>
    </div>
</MainLayout>
