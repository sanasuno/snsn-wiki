---
/**
 * ./src/pages/[locale]/tag/index.astro
 * タグ一覧ページ
 */
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, locales, type Locale } from '@lib/i18n';
import { getLocaleBaseUrl, ensureTrailingSlash } from '@lib/path';
import { getUniquePagesByLocale } from '@lib/pages';
import MainLayout from '@layouts/MainLayout.astro';
import ListPageItem from '@layouts/ListPageItem.astro';

export const getStaticPaths = () => {
    return locales.map((locale) => ({
        params: { locale },
        props: { locale },
    }));
};

const { locale } = Astro.props as { locale: Locale };
const localeBaseUrl = getLocaleBaseUrl(locale);

const wikiPages = await getCollection('wiki', (p) => !p.data.draft);
const pages = getUniquePagesByLocale(wikiPages, locale);
const tagMap: Record<string, typeof pages> = {};
for (const page of pages) {
    const tags = page.data.tags || [];
    for (const tag of tags) {
        if (!tagMap[tag]) {
            tagMap[tag] = [];
        }
        tagMap[tag].push(page);
    }
}
const sortedTags = Object.entries(tagMap).sort(([a], [b]) => a.localeCompare(b, locale));

const alternateLinks = locales.map((locale) => ({
    locale: locale,
    href: getRelativeLocaleUrl(locale, 'tag'),
}));
---
<MainLayout
    title={t('tagpage.title', locale)}
    description={t('tagpage.description', locale)}
    locale={locale}
    type="tag"
    showSubpanel={false}
    alternateLinks={alternateLinks}
>
    <div class="listpage-header">
        <div class="listpage-counter">
            {Object.keys(tagMap).length} {t('count.tags', locale)}
        </div>
    </div>
    <div class="listpage-content">
        <ul class="listpage-list">
            {sortedTags.map(([tag, pages]) => {
                return (
                    <li class="listpage-section">
                        <div class="listpage-section-header">
                            <a href={ensureTrailingSlash(`${localeBaseUrl}tag/${tag}`)} class="listpage-section-title">
                                <h3>#{tag}</h3>
                            </a>
                            <div class="listpage-section-count">
                                {pages.length} {t('count.pages', locale)}
                            </div>
                        </div>
                        <ul class="listpage-item-list">
                            {pages.map((page) => <ListPageItem page={page} locale={locale} /> )}
                        </ul>
                    </li>
                )
            })}
        </ul>
    </div>
</MainLayout>
