---
/**
 * ./src/pages/[locale]/tag/index.astro
 * タグ一覧ページ
 */
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, locales, type Locale } from '@lib/i18n';
import { getLocaleBaseUrl, getWikiUrl, ensureTrailingSlash } from '@lib/path';
import { getUniquePagesByLocale } from '@lib/pages';
import { formatDate } from '@lib/date';
import MainLayout from '@layouts/MainLayout.astro';

export const getStaticPaths = () => {
    return locales.map((locale) => ({
        params: { locale },
    }));
};

const locale = Astro.params.locale as Locale;
const localeBaseUrl = getLocaleBaseUrl(locale);

const wikiPages = await getCollection('wiki', (p) => !p.data.draft);
const pages = getUniquePagesByLocale(wikiPages, locale);
const tagMap: Record<string, typeof pages> = {};
for (const page of pages) {
    const tags = page.data.tags || [];
    for (const tag of tags) {
        if (!tagMap[tag]) {
            tagMap[tag] = [];
        }
        tagMap[tag].push(page);
    }
}
const sortedTags = Object.entries(tagMap).sort(([a], [b]) =>
    a[0].localeCompare(b[0], locale)
);

const alternateLinks = locales.map((locale) => ({
    locale: locale,
    href: getRelativeLocaleUrl(locale, 'tag'),
}));
---
<MainLayout
    title={t('tagpage.title', locale)}
    description={t('tagpage.description', locale)}
    locale={locale}
    type="tag"
    alternateLinks={alternateLinks}
>
    <div class="listpage-header">
        <div class="listpage-counter">
            {Object.keys(tagMap).length} {t('tagpage.count', locale)}
        </div>
    </div>
    <div class="listpage-content">
        <ul class="listpage-list">
            {sortedTags.map(([tag, pages]) => {
                return (
                    <section class="listpage-section">
                        <a href={ensureTrailingSlash(`${localeBaseUrl}tag/${tag}`)} class="listpage-section-title">
                            <h3>#{tag}</h3>
                        </a>
                        <div class="listpage-section-count">
                            {pages.length} {t('tagpage.count', locale)}
                        </div>
                        <ul class="listpage-item-list">
                            {pages.map((page) => {
                                const updated = page.data.updated ?? page.data.date ?? new Date(0);
                                const isUpdated = !!page.data.updated;
                                return (
                                    <li class="listpage-item">
                                        <div class="listpage-item-left">
                                            <div class="listpage-item-content">
                                                <a href={getWikiUrl(page.id, locale)}>
                                                    <i class="fa-regular fa-file-lines"></i>
                                                    {page.data.title}
                                                </a>
                                                {page.data.tags && (
                                                    <div class="listpage-item-tags">
                                                        {page.data.tags.map((tag) => (
                                                            <a href={ensureTrailingSlash(`${localeBaseUrl}tag/${tag}`)} class="listpage-item-tag">
                                                                #{tag}
                                                            </a>
                                                        ))}
                                                    </div>
                                                )}
                                                {page.data.description && (
                                                    <p class="listpage-item-description">
                                                        {page.data.description}
                                                    </p>
                                                )}
                                            </div>
                                            {page.data.description && (
                                                <p class="listpage-item-description">
                                                    {page.data.description}
                                                </p>
                                            )}
                                        </div>
                                        <div class="listpage-item-right">
                                            <p class="listpage-item-updated">
                                                <i class={`${isUpdated ? 'fas fa-clock-rotate-left' : 'far fa-calendar-plus'}`} aria-hidden="true"></i>
                                                {formatDate(updated, locale)}
                                            </p>
                                        </div>
                                    </li>
                                )
                            })}
                        </ul>
                    </section>
                )
            })}
        </ul>
    </div>
</MainLayout>
