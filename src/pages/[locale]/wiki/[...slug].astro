---
/**
 * ./src/pages/[locale]/wiki/[...slug].astro
 * ウィキページの動的ルーティング用ページ
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { dividePageId, normalizeSlug } from '@lib/slug';
import { locales, defaultLocale, type Locale } from '@i18n/i18n.config';
import MainLayout from '@layouts/MainLayout.astro';
import { removeTrailingSlash } from '@lib/path';

interface Props {
    page: CollectionEntry<'wiki'>;
    locale: Locale;
    baseSlug: string;
    isFallback: boolean;
}

/**
 * Astroの静的パス生成関数
 * wikiコレクションからページを収集し、ロケールとベーススラッグごとにグループ化する
 * URL衝突を検証し、各ページのパスを生成する
 */
export async function getStaticPaths() {
    const wikiPages = await getCollection('wiki', (page) => !page.data.draft);

    const pagesByBaseSlug: Record<string, Partial<Record<Locale, CollectionEntry<'wiki'>>>> = {};
    const normalizedIdOwners: Record<string, Set<string>> = {};
    
    for (const page of wikiPages) {
        const { locale, rawBaseSlug } = dividePageId(page.id);
        
        const normalizedBaseSlug = normalizeSlug(rawBaseSlug);
        if (!pagesByBaseSlug[normalizedBaseSlug]) {
            pagesByBaseSlug[normalizedBaseSlug] = {};
        }
        pagesByBaseSlug[normalizedBaseSlug][locale] = page;
        
        const normalizedId = normalizeSlug(page.id);        
        if (!normalizedIdOwners[normalizedId]) {
            normalizedIdOwners[normalizedId] = new Set();
        }
        normalizedIdOwners[normalizedId].add(page.id);
    }

    // 正規化によって衝突するIDがないか検証
    for (const [normalizedId, owners] of Object.entries(normalizedIdOwners)) {
        if (owners.size > 1) {
            throw new Error(`[wiki routing] Multiple owners for normalized ID "${normalizedId}": ${Array.from(owners).join(', ')}`);
        }
    }

    const paths: { params: { locale: Locale; slug: string | undefined }; props: Props }[] = [];
    for (const baseSlug of Object.keys(pagesByBaseSlug)) {
        const availablePages = pagesByBaseSlug[baseSlug];
        for (const locale of locales) {
            const slug = baseSlug === ''
                ? undefined
                : baseSlug;
            const isFallback = !availablePages[locale];
            const fallbackPage = availablePages[locale]
                ?? availablePages[defaultLocale]
                ?? locales.map((loc) => availablePages[loc]).find(
                    (p): p is CollectionEntry<'wiki'> => p !== undefined
                );
            if (!fallbackPage) {
                throw new Error(`[wiki routing] No page found for baseSlug "${baseSlug}"`);
            }
            const page = fallbackPage;

            paths.push({
                params: { locale, slug },
                props: {
                    page,
                    locale,
                    baseSlug,
                    isFallback,
                }
            })
        }
    }
    return paths;
}

const { page, locale, baseSlug, isFallback } = Astro.props;
const { Content } = await render(page);

const baseUrl = removeTrailingSlash(import.meta.env.BASE_URL);
const alternateLinks = locales.map(altLocale => ({
    locale: altLocale,
    href: removeTrailingSlash(new URL(`${baseUrl}/${altLocale}/wiki/${baseSlug}`, Astro.site).toString())
}))
---
<MainLayout
    title={page.data.title}
    description={page.data.description}
    locale={locale}
    alternateLinks={alternateLinks}
    hasToc={page.data.hasToc}
    isFallback={isFallback}
    date={page.data.date}
    updated={page.data.updated}
>
    <Content />
</MainLayout>