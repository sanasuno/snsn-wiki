---
/**
 * ./src/pages/[locale]/wiki/[...slug].astro
 * ウィキページの動的ルーティング用ページ
 */
import { render, type CollectionEntry } from 'astro:content';
import { locales, type Locale } from '@i18n/i18n.config';
import { resolveWikiPages } from '@lib/pages';
import MainLayout from '@layouts/MainLayout.astro';
import { getWikiBaseUrl } from '@lib/path';

interface Props {
    page: CollectionEntry<'wiki'>;
    locale: Locale;
    slug: string;
    isFallback: boolean;
}

/**
 * Astroの静的パス生成関数
 * wikiコレクションからページを収集し、ロケールとベーススラッグごとにグループ化する
 * URL衝突を検証し、各ページのパスを生成する
 * @returns {Promise<{ params: { locale: Locale; slug: string | undefined }; props: Props }[]>} パスとプロパティの配列
 */
export async function getStaticPaths() {
    const resolvedPages = await resolveWikiPages();
    return resolvedPages.map(({ locale, slug, page, isFallback }) => ({
        params: {
            locale,
            slug: slug === '' ? undefined : slug,
        },
        props: { page, locale, slug, isFallback },
    }));
}

const { page, locale, slug, isFallback } = Astro.props;

// 代替リンク生成
const alternateLinks = locales.map(altLocale => ({
    locale: altLocale,
    href: `${getWikiBaseUrl(altLocale)}/${slug}`
}));

const { Content, headings } = await render(page);
---
<MainLayout
    title={page.data.title}
    description={page.data.description}
    locale={locale}
    alternateLinks={alternateLinks}
    isFallback={isFallback}
    tags={page.data.tags}
    date={page.data.date}
    updated={page.data.updated}
    isSubPage={page.data.isSubPage}
    showSubpanel={page.data.showSubpanel}
    headings={headings}
>
    <Content />
</MainLayout>