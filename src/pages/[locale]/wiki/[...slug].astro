---
/**
 * ./src/pages/[locale]/wiki/[...slug].astro
 * ウィキページの動的ルーティング用ページ
 */
import { render, type CollectionEntry } from 'astro:content';
import { locales, type Locale } from '@lib/i18n';
import { resolveWikiPages } from '@lib/pages';
import { getWikiBaseUrl, getWikiUrl, ensureTrailingSlash } from '@lib/path';
import MainLayout from '@layouts/MainLayout.astro';

interface Props {
    page: CollectionEntry<'wiki'>;
    locale: Locale;
    slug: string;
    isFallback: boolean;
    fallbackLocale: Locale;
    availableLocales: Locale[];
}

/**
 * Astroの静的パス生成関数
 * @returns パスとプロパティの配列
 */
export async function getStaticPaths() {
    const resolvedPages = await resolveWikiPages();
    return resolvedPages.map(({ locale, slug, page, isFallback, fallbackLocale, availableLocales }) => ({
        params: {
            locale,
            slug: slug === '' ? undefined : slug,
        },
        props: { page, locale, slug, isFallback, fallbackLocale, availableLocales },
    }));
}

const { page, locale, slug, isFallback, fallbackLocale, availableLocales } = Astro.props;

// 代替リンク生成
const toLink = (loc: Locale) => ({
    locale: loc,
    href: ensureTrailingSlash(`${getWikiBaseUrl(loc)}${slug}`)
});
const alternateLinks = availableLocales.map(toLink);
const switchLinks = locales.map(toLink);
const canonicalHref = isFallback ? getWikiUrl(page.id, fallbackLocale) : undefined;

const { Content, headings } = await render(page);
---
<MainLayout
    title={page.data.title}
    description={page.data.description}
    locale={locale}
    alternateLinks={alternateLinks}
    type='wiki'
    isFallback={isFallback}
    fallbackLocale={fallbackLocale}
    switchLinks={switchLinks}
    canonicalHref={canonicalHref}
    tags={page.data.tags}
    date={page.data.date}
    updated={page.data.updated}
    id={page.id}
    isSubpage={page.data.isSubpage}
    showSubpanel={page.data.showSubpanel}
    headings={headings}
>
    <Content />
</MainLayout>