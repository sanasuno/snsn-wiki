---
/**
 * ./src/pages/[locale]/category/[...category].astro
 * カテゴリページ
 */
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCategoryArray, getCategory, translateCategory, matchCategory, getChildCategory } from '@lib/category';
import { getCategoryUrl } from '@lib/path';
import { getUniquePagesByLocale } from '@lib/pages';
import MainLayout from '@layouts/MainLayout.astro';
import ListPageItem from '@layouts/ListPageItem.astro';
import { t, locales, type Locale } from '@lib/i18n';

export async function getStaticPaths() {
    const pages = await getCollection('wiki', (p) => !p.data.draft);
    const categorySet = new Set<string>(['']);
    for (const page of pages) {
        const categoryArray = getCategoryArray(page.id, page.data.isSubpage);
        for (const category of categoryArray) {
            categorySet.add(category);
        }
    }
    const paths: { params: { locale: Locale; category: string | undefined }; props: { locale: Locale; category: string } }[] = [];
    for (const locale of locales) {
        for (const category of categorySet) {
            paths.push({
                params: {
                    locale,
                    category: category === '' ? undefined : category,
                },
                props: {
                    locale,
                    category: category,
                },
            });
        }
    }
    return paths;
}

interface Props {
    locale: Locale;
    category: string;
}

const { locale, category } = Astro.props as Props;

const categoryArray = category === '' ? [] : category.split('/');

const wikiPages = await getCollection('wiki', (p) => !p.data.draft);
const inCategory = getUniquePagesByLocale(wikiPages, locale).filter((page) => {
    const pageCategory = getCategory(page.id, page.data.isSubpage);
    return matchCategory(pageCategory, category);
})
const sortedPages = [...inCategory].sort((a, b) =>
    (a.data.order - b.data.order) || a.data.title.localeCompare(b.data.title, locale)
);
const directPages = sortedPages.filter((page) => getCategory(page.id, page.data.isSubpage) === category);

const pagesByChild = new Map<string, typeof sortedPages>();
for (const page of sortedPages) {
    const child = getChildCategory(getCategory(page.id, page.data.isSubpage), category);
    if (!child) continue;
    const list = pagesByChild.get(child) ?? [];
    list.push(page);
    pagesByChild.set(child, list);
}
const childCategoryPages = [...pagesByChild].map(([path, pages]) => ({
    path,
    pages,
    href: getCategoryUrl(locale, path),
    label: translateCategory(path, locale),
})).sort((a, b) => a.label.localeCompare(b.label, locale))

const alternateLinks = locales.map((loc) => ({
    locale: loc,
    href: getRelativeLocaleUrl(loc, `/category/${category}`),
}))
---
<MainLayout
    title={category === '' ? t('categorypage.title', locale) : translateCategory(category, locale)}
    description={t('categorypage.description', locale)}
    locale={locale}
    alternateLinks={alternateLinks}
    type="category"
    id={category}
    isSubpage={categoryArray.length > 0}
    showSubpanel={false}
>
    <div class="listpage-header">
        <div class="listpage-counter">
            {childCategoryPages.length} {t('count.categories', locale)} / {sortedPages.length} {t('count.pages', locale)}
        </div>
    </div>
    <div class="listpage-content">
        {childCategoryPages.length > 0 && (
            <ul class="listpage-list">
                {childCategoryPages.map((child) => (
                    <li class="listpage-section">
                        <div class="listpage-section-header">
                            <a href={child.href} class="listpage-section-title">
                                <h3><i class="fas fa-folder" aria-hidden="true"></i> {child.label}</h3>
                            </a>
                            <div class="listpage-section-count">
                                {child.pages.length} {t('count.pages', locale)}
                            </div>
                        </div>
                        <ul class="listpage-item-list">
                            {child.pages.map((page) => <ListPageItem page={page} locale={locale} />)}
                        </ul>
                    </li>
                ))}
            </ul>
        )}
        {directPages.length > 0 && (
            <section class="listpage-section">
                <div class="listpage-section-header">
                    <div class="listpage-section-title">
                        <h3><i class="fas fa-folder-open" aria-hidden="true"></i> {t('categorypage.directpages', locale)}</h3>
                    </div>
                    <div class="listpage-section-count">
                        {directPages.length} {t('count.pages', locale)}
                    </div>
                </div>
                <ul class="listpage-item-list">
                    {directPages.map((page) => <ListPageItem page={page} locale={locale} />)}
                </ul>
            </section>
        )}
    </div>
</MainLayout>