---
/**
 * ./src/pages/[locale]/categpru/[...category].astro
 * カテゴリページ
 */
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCategoryArray, translateCategory } from '@lib/category';
import { getLocaleBaseUrl, ensureTrailingSlash } from '@lib/path';
import MainLayout from '@layouts/MainLayout.astro';
import { t, locales, type Locale } from '@lib/i18n';

export async function getStaticPaths() {
    const pages = await getCollection('wiki', (p) => !p.data.draft);
    const categorySet = new Set<string>(['']);
    for (const page of pages) {
        const categoryArray = getCategoryArray(page.id, page.data.isSubpage);
        for (const category of categoryArray) {
            categorySet.add(category);
        }
    }
    const paths: { params: { locale: Locale; category: string | undefined }; props: { locale: Locale; categoryString: string } }[] = [];
    for (const locale of locales) {
        for (const category of categorySet) {
            paths.push({
                params: {
                    locale,
                    category: category === '' ? undefined : category,
                },
                props: {
                    locale,
                    categoryString : category,
                },
            });
        }
    }
    return paths;
}

interface Props {
    locale: Locale;
    categoryString: string;
}

const { locale, categoryString } = Astro.props as Props;

const localeBaseUrl = getLocaleBaseUrl(locale);

const category = categoryString === '' ? [] : categoryString.split('/');
const parentCategory = category.slice(0, -1).join('/');
const parentHref = ensureTrailingSlash(`${localeBaseUrl}category/${parentCategory}`);
const parentLabel = parentCategory === ''
    ? t('categorypage.title', locale)
    : translateCategory(parentCategory, locale);

const alternateLinks = locales.map((loc) => ({
    locale: loc,
    href: getRelativeLocaleUrl(loc, `/category/${categoryString}`),
}))
---
<MainLayout
    title={categoryString === '' ? t('categorypage.title', locale) : translateCategory(categoryString, locale)}
    description={t('categorypage.description', locale)}
    locale={locale}
    alternateLinks={alternateLinks}
    type="sppage"
    showSubpanel={false}
>
    <div class="sppage-title">
        {category.length > 0 && (
            <div class="sppage-back">
                <a href={parentHref}>
                    <i class="fas fa-arrow-left"></i>
                    {parentLabel}
                </a>
            </div>
        )}
        <h1 class="indexpage-title">
            <i class="fas fa-folder"></i>
            {category.length === 0
                ? <span>{t('categorypage.title', locale)}</span>
                : category.map((_, index) => {
                    const path = category.slice(0, index + 1).join('/');
                    const isLast = index === category.length -1;
                    return (
                        <>
                            {index > 0 &&
                                <span class="category-separator"> / </span>
                            }
                            {isLast
                                ? <span>{translateCategory(path, locale)}</span>
                                : <a href={ensureTrailingSlash(`${localeBaseUrl}category/${path}`)}>{translateCategory(path, locale)}</a>
                            }
                        </>
                    );
            })}
        </h1>
    </div>
</MainLayout>