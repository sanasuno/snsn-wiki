---
/**
 * @layouts/Header.astro
 * ヘッダーコンポーネント
 * @param locale ロケール
 * @param localeBaseUrl ロケールベースURL
 * @param currentPath 現在のパス
 */
import { t, locales, type Locale } from "@i18n/i18n.config";
import { headerNavItems } from "@layouts/header.nav";
import { removeTrailingSlash, getLocaleBaseUrl, isActive } from "@lib/path";

interface Props {
    locale: Locale;
}
const { locale }: Props = Astro.props;
const localeBaseUrl = getLocaleBaseUrl(locale);
const currentPath = removeTrailingSlash(Astro.url.pathname) || '/';
const showLanguageSwitcher: boolean = locales.length > 1;
---
<header class="site-header">
    <button type="button" class="sidebar-toggle" id="sidebar-toggle" aria-label={t("header.sidebar.toggle", locale)} aria-expanded="false" aria-controls="sidebar">
        <i class="fas fa-bars" aria-hidden="true"></i>
    </button>

    <a href={localeBaseUrl} class="site-title">
        {t("site.title", locale)}
    </a>
    <nav class="header-nav" aria-label={t("header.nav.title", locale)}>
        {
            headerNavItems.map((item) => (
                <a href={localeBaseUrl + item.path} class={isActive(item.path, currentPath) ? "active" : ""}>
                    {item.icon && <i class={item.icon}></i>}
                    <span class="nav-label" data-i18n={item.i18nKey}>
                        {t(item.i18nKey, locale)}
                    </span>
                </a>
            ))
        }
    </nav>
    
    <button type="button" class="theme-toggle" id="theme-toggle" aria-label={t("header.theme.toggle", locale)} aria-pressed="false">
        <i class="fas fa-sun icon-light" aria-hidden="true"></i>
        <i class="fas fa-moon icon-dark" aria-hidden="true"></i>
    </button>

    { showLanguageSwitcher && (
        <div class="language-switcher">
            <i class="fas fa-language" aria-hidden="true"></i>
            <select id="language-list" class="language-list" aria-label={t("header.language.select", locale)}>
                {locales.map((loc) => (
                    <option value={loc} selected={loc === locale}>
                        {t("lang.name", loc)}
                    </option>
                ))}
            </select>
            <i class="fas fa-chevron-down language-arrow" aria-hidden="true"></i>
        </div>
    )}
</header>
