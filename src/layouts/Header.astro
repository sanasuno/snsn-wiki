---
/**
 * @layouts/Header.astro
 * ヘッダーレイアウト
 */
import { t, type Locale } from "@i18n/i18n.config";

interface Props {
    locale: Locale;
    localeBaseUrl: string;
}
const { locale, localeBaseUrl }: Props = Astro.props;
---
<header class="site-header">
    <button class="sidebar-toggle" id="sidebar-toggle" aria-label={t("header.sidebar.toggle", locale)} aria-expanded="false" aria-pressed="false" aria-controls="sidebar">
        <i class="fas fa-bars" aria-hidden="true"></i>
    </button>

    <a href={localeBaseUrl} class="site-title">
        {t("site.title", locale)}
    </a>
    
    <button class="theme-toggle" id="theme-toggle" aria-label={t("header.theme.toggle", locale)} aria-pressed="false" aria-controls="theme-preference">
        <i class="fas fa-sun icon-light" aria-hidden="true"></i>
        <i class="fas fa-moon icon-dark" aria-hidden="true"></i>
    </button>
</header>