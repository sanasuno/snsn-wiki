---
/**
 * @layouts/Header.astro
 * ヘッダーコンポーネント
 */
import { t, locales, type Locale } from '@i18n/i18n.config';
import { headerNavItems } from '@layouts/header.nav';
import { getCurrentPath, getWikiBaseUrl, getLocalePathUrl, isPathActive } from '@lib/path';

interface Props {
    locale: Locale;
}
const { locale }: Props = Astro.props;
const wikiBaseUrl = getWikiBaseUrl(locale);
const showLanguageSwitcher: boolean = locales.length > 1;

const currentPath = getCurrentPath(Astro.url);
const navItems = headerNavItems.map((item) => ({
    ...item,
    href: getLocalePathUrl(locale, item.path),
    active: isPathActive(item.path, currentPath, item.exact),
}));
---
<a href="#main-content" class="skip-link">
    {t('header.skip', locale)}
</a>
<header class="site-header">
    <button type="button" class="sidebar-toggle" id="sidebar-toggle" aria-label={t('header.sidebar.toggle', locale)} aria-expanded="false" aria-controls="sidebar">
        <i class="fas fa-bars" aria-hidden="true"></i>
    </button>

    <a href={wikiBaseUrl} class="header-site-title">
        {t('site.title', locale)}
    </a>
    
    <nav class="header-nav" aria-label={t('header.nav.title', locale)}>
        {navItems.map((item) => (
            <a href={item.href} class:list={['header-nav-link', { active: item.active, 'has-icon': !!item.icon }]} aria-current={item.active ? "page" : undefined}>
                {item.icon && <i class={item.icon} aria-hidden="true"></i>}
                <span class="header-nav-label" data-i18n={item.i18nKey}>
                    {t(item.i18nKey, locale)}
                </span>
            </a>
        ))}
    </nav>
    
    <button type="button" class="theme-toggle" id="theme-toggle" aria-label={t('header.theme.toggle', locale)}>
        <i class="fas fa-moon theme-icon-light" aria-hidden="true"></i>
        <i class="fas fa-sun theme-icon-dark" aria-hidden="true"></i>
    </button>

    { showLanguageSwitcher && (
        <div class="language-switcher">
            <i class="fas fa-language" aria-hidden="true"></i>
            <select id="language-list" class="language-switcher-list" aria-label={t('header.language.select', locale)}>
                {locales.map((loc) => (
                    <option value={loc} selected={loc === locale}>
                        {t('lang.name', loc)}
                    </option>
                ))}
            </select>
            <i class="fas fa-chevron-down language-switcher-arrow" aria-hidden="true"></i>
        </div>
    )}
</header>
