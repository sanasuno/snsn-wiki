---
/**
 * @layouts/MainLayout.astro
 * サイト全体のレイアウト定義ファイル
 */
import { defaultLocale } from '@i18n/i18n.config';
import { t, type Locale } from '@lib/i18n';
import { getBaseUrl, getLocaleBaseUrl, getWikiBaseUrl, getCurrentPath, removeTrailingSlash } from '@lib/path';

import Header from '@layouts/Header.astro';
import Sidebar from '@layouts/Sidebar.astro';
import MainContent from '@layouts/MainContent.astro';
import Footer from '@layouts/Footer.astro';
import Toc from '@layouts/Toc.astro';
import MiniGraph from '@layouts/MiniGraph.astro';

import '@fortawesome/fontawesome-free/css/all.min.css';

import '@styles/theme.css';
import '@styles/base.css';
import '@styles/layout.css';
import '@styles/header.css';
import '@styles/sidebar.css';
import '@styles/main-content.css';
import '@styles/subpanel.css';
import '@styles/footer.css';
import '@styles/custom.css';

interface Props {
    title: string;
    description?: string;
    locale?: Locale;
    alternateLinks?: { locale: Locale; href: string }[];
    type: 'wiki' | 'sppage' | 'other';
    isFallback?: boolean;
    fallbackLocale?: Locale;
    tags?: string[];
    date?: Date;
    updated?: Date;
    id?: string;
    isSubpage?: boolean;
    headings?: { depth: number; slug: string; text: string }[];
    showSubpanel?: boolean;
}

const {
    title,
    description,
    locale = defaultLocale,
    alternateLinks = [],
    type = 'other',
    isFallback = false,
    fallbackLocale,
    tags = [],
    date,
    updated,
    id,
    isSubpage = false,
    headings = [],
    showSubpanel = true,
} = Astro.props;

// ベース URL
const baseUrl = getBaseUrl();
const localeBaseUrl = getLocaleBaseUrl(locale);
const wikiBaseUrl = getWikiBaseUrl(locale);

// 現在のパス
const currentPath = getCurrentPath(Astro.url);

// カノニカル URL
const canonicalUrl = new URL(currentPath, Astro.url).href;

// OGP 用スラッグ
const ogSlug = currentPath.startsWith(wikiBaseUrl)
    ? removeTrailingSlash(`${currentPath.slice(localeBaseUrl.length)}`)
    : 'index';
const ogImageUrl = new URL(`${localeBaseUrl}og/${ogSlug}.png`, Astro.url).href;

// デフォルトの代替リンク
const defaultAlternateLink = alternateLinks.find(link => link.locale === defaultLocale);

// サイトタイトルと説明
const siteTitle = t('site.title', locale);
const siteDescription = t('site.description', locale);

// ページタイトルと説明
const pageTitle = `${title} | ${siteTitle}`;
const pageDescription = description ?? siteDescription;
---
<!DOCTYPE html>
<html lang={locale} data-lang={locale}>
    <head prefix="og: https://ogp.me/ns#">
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />
        <meta name="generator" content="snsn-wiki" />
        <link rel="icon" href={new URL(`${baseUrl}favicon.ico`, Astro.url).href} sizes="48x48" />
        <link rel="icon" href={new URL(`${baseUrl}favicon.svg`, Astro.url).href} type="image/svg+xml" />
        <link rel="sitemap" href={new URL(`${baseUrl}sitemap-index.xml`, Astro.url).href} />
        <link rel="canonical" href={canonicalUrl} />
        {defaultAlternateLink && <link rel="alternate" href={new URL(defaultAlternateLink.href, Astro.url).href} hreflang="x-default" />}
        {alternateLinks.map(link => <link rel="alternate" href={new URL(link.href, Astro.url).href} hreflang={link.locale} />)}

        <!-- OGP -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:type" content={type === 'wiki' ? 'article' : 'website'} />
        <meta property="og:site_name" content={siteTitle} />
        <meta property="og:locale" content={t('og.locale', locale)} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={pageDescription} />
        <meta name="twitter:image" content={ogImageUrl} />

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Mono:wght@100..900&family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Noto+Serif:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100..900&family=Noto+Serif+JP:wght@200..900&display=swap" rel="stylesheet">

        <!-- テーマ初期化スクリプト -->
        <script is:inline>
            (function() {
                let savedTheme = null;
                try { savedTheme = localStorage.getItem('theme'); } catch (e) {}
                if (savedTheme) {
                    document.documentElement.setAttribute('data-theme', savedTheme);
                } else {
                    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                    document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
                }
            })();
        </script>

        <!-- 言語初期化スクリプト -->
        <script>
            import { initI18n } from '@scripts/languageSwitch';
            initI18n();
        </script>
    </head>
    <body>
        <Header
            locale={locale}
        />
        <div class={`layout${showSubpanel ? '' : ' no-subpanel'}`}>
            <Sidebar
                locale={locale}
            />
            <MainContent
                title={title}
                locale={locale}
                type={type}
                tags={tags}
                date={date}
                updated={updated}
                id={id}
                isSubpage={isSubpage}
                isFallback={isFallback}
                fallbackLocale={fallbackLocale}
            >
                <slot />
            </MainContent>
            {showSubpanel && (
                <>
                    <aside class="subpanel" id="subpanel">
                        <Toc
                            locale={locale}
                            headings={headings}
                        />
                        <MiniGraph
                            locale={locale}
                        />
                    </aside>
                    <button type="button" class="subpanel-drawer-button" id="subpanel-drawer-button" aria-label={t('subpanel.open', locale)} aria-controls="subpanel" aria-expanded="false">
                        <i class="fas fa-list-ul" aria-hidden="true"></i>
                    </button>
                </>
            )}
        </div>
        <Footer
            locale={locale}
        />
        <script>
            import '@scripts/main';
        </script>
    </body>
</html>