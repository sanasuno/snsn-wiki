---
/**
 * @layouts/MainLayout.astro
 * サイト全体のレイアウト定義ファイル
 */

import { t, defaultLocale, type Locale } from '@i18n/i18n.config';
import { removeTrailingSlash } from '@lib/path';

import Header from '@layouts/Header.astro';
import Sidebar from '@layouts/Sidebar.astro';
import MainContent from '@layouts/MainContent.astro';
import Footer from '@layouts/Footer.astro';
import Toc from '@layouts/Toc.astro';
import MiniGraph from '@layouts/MiniGraph.astro';

import '@fortawesome/fontawesome-free/css/all.min.css';

import '@styles/global.css';
import '@styles/theme.css';
import '@styles/custom.css';

interface Props {
    title: string;
    description?: string;
    locale?: Locale;
    alternateLinks?: { locale: Locale; href: string }[];
    isFallback?: boolean;
    tags?: string[];
    date?: Date;
    updated?: Date;
    isSubPage?: boolean;
    headings?: { depth: number; slug: string; text: string }[];
    showSubpanel?: boolean;
}

const {
    title,
    description,
    locale = defaultLocale,
    alternateLinks = [],
    isFallback = false,
    tags = [],
    date,
    updated,
    isSubPage = false,
    headings = [],
    showSubpanel = true,
} = Astro.props;

const baseUrl = removeTrailingSlash(import.meta.env.BASE_URL);
const localeBaseUrl = `${baseUrl}/${locale}`;
const wikiBaseUrl = `${localeBaseUrl}/wiki`;

const currentPath = removeTrailingSlash(Astro.url.pathname) || '/';

const canonicalUrl = new URL(currentPath, Astro.url).href;

const ogSlug = currentPath.startsWith(wikiBaseUrl)
    ? `wiki${currentPath.slice(wikiBaseUrl.length)}`
    : 'index';
const ogImageUrl = new URL(`${localeBaseUrl}/og/${ogSlug}.png`, Astro.url).href;

const defaultAlternateLink = alternateLinks.find(link => link.locale === defaultLocale);

const siteTitle = t('site.title', locale);
const siteDescription = t('site.description', locale);

const pageTitle = `${title} | ${siteTitle}`;
const pageDescription = description ?? siteDescription;
---
<!DOCTYPE html>
<html lang={locale} data-lang={locale}>
    <head prefix="og: https://ogp.me/ns#">
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />
        <meta name="generator" content="snsn-wiki" />
        {isFallback && <meta name="robots" content="noindex, follow" />}
        <link rel="icon" href={new URL(`${baseUrl}/favicon.ico`, Astro.url).href} sizes="48x48" />
        <link rel="icon" href={new URL(`${baseUrl}/favicon.svg`, Astro.url).href} type="image/svg+xml" />
        <link rel="sitemap" href={new URL(`${baseUrl}/sitemap-index.xml`, Astro.url).href} />
        <link rel="canonical" href={canonicalUrl} />
        {defaultAlternateLink && <link rel="alternate" href={new URL(defaultAlternateLink.href, Astro.url).href} hreflang="x-default" />}
        {alternateLinks.map(link => <link rel="alternate" href={new URL(link.href, Astro.url).href} hreflang={link.locale} />)}

        <!-- OGP -->
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:type" content="article" />
        <meta property="og:site_name" content={siteTitle} />
        <meta property="og:locale" content={t('og.locale', locale)} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:description" content={pageDescription} />
        <meta name="twitter:image" content={ogImageUrl} />

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Mono:wght@100..900&family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Noto+Serif:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100..900&family=Noto+Serif+JP:wght@200..900&display=swap" rel="stylesheet">

        <!-- テーマ初期化スクリプト -->
        <script is:inline>
            (function() {
                const savedTheme = localStorage.getItem('theme');
                if (savedTheme) {
                    document.documentElement.setAttribute('data-theme', savedTheme);
                } else {
                    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                    document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
                }
            })();
        </script>

        <!-- i18n初期化スクリプト -->
        <script>
            import { initI18n } from '@scripts/i18n';
            initI18n();
        </script>
    </head>
    <body>
        <div class={`layout${showSubpanel ? '' : ' no-subpanel'}`}>
            <Header
                locale={locale}
                localeBaseUrl={localeBaseUrl}
                currentPath={currentPath}
            />
            <Sidebar
                locale={locale}
                localeBaseUrl={localeBaseUrl}
                currentPath={currentPath}
            />
            <main class="main-panel">
                <MainContent
                    title={title}
                    locale={locale}
                    localeBaseUrl={localeBaseUrl}
                    currentPath={currentPath}
                    tags={tags}
                    date={date}
                    updated={updated}
                    isSubPage={isSubPage}
                    isFallback={isFallback}
                >
                    <slot />
                </MainContent>
                <Footer
                    locale={locale}
                    localeBaseUrl={localeBaseUrl}
                />
            </main>
            {showSubpanel && (
                <aside class="subpanel">
                    <Toc
                        locale={locale}
                        headings={headings}
                    />
                    <MiniGraph
                        locale={locale}
                        localeBaseUrl={localeBaseUrl}
                        currentPath={currentPath}
                    />
                </aside>
            )}
        </div>
        <script>
            import '@scripts/main';
        </script>
    </body>
</html>