---
/**
 * @layouts/Sidebar.astro
 * サイドバーコンポーネント
 */
import { getCollection } from "astro:content";
import { t, type Locale, type TranslationKey } from "@i18n/i18n.config";
import { sidebarNavItems, autoAddUnknownCategories, autoGroupByLeafCategory } from "@layouts/sidebar.nav";
import { getUniquePagesByLocale } from '@lib/pages';
import { normalizeSlugLike, getNormalizedSlug, getLocaleBaseUrl, getWikiUrl, getCurrentPath, isPathActive } from '@lib/path';
import { getCategory } from '@lib/category';

interface Props {
    locale: Locale;
}
const { locale }: Props = Astro.props;

const localeBaseUrl = getLocaleBaseUrl(locale);
const currentPath = decodeURIComponent(getCurrentPath(Astro.url));

const wikiPages = await getCollection('wiki', (page) => !page.data.draft);
const uniquePages = getUniquePagesByLocale(wikiPages, locale);
const pagesByCategory : Record<string, typeof uniquePages> = {};
const slugMap : Record<string, (typeof uniquePages)[0]> = {};
for (const page of uniquePages) {
    slugMap[getNormalizedSlug(page.id)] = page;
    const category: string[] = getCategory(page.id, page.data.isSubPage);
    const key = category.length > 0 && autoGroupByLeafCategory
        ? category[category.length - 1]
        : category.join('/');
    (pagesByCategory[key] ??= []).push(page);
}

const renderedCategories = new Set<string>();

type WikiPage = typeof wikiPages[0];
const sorters: Record<string, (a: WikiPage, b: WikiPage) => number> = {
    title: (a, b) => a.data.title.localeCompare(b.data.title),
    order: (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
    date: (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
    updated: (a, b) => (b.data.updated?.getTime() ?? 0) - (a.data.updated?.getTime() ?? 0),
};
---
<aside class="sidebar" id="sidebar">
    <nav aria-label={t("sidebar.nav.title", locale)}>
        {
            sidebarNavItems.map((section) => {
                const defaultCollapsed = section.collapsed ?? false;
                if (section.category) {
                    const categoryPages = pagesByCategory[section.category] || [];
                    if (categoryPages.length === 0) {
                        return null;
                    }
                    renderedCategories.add(section.category);
                    const sorted = [...categoryPages].sort((a, b) => {
                        return sorters[section.sort ?? 'title'](a, b);
                    });

                    return (
                        <section class='sidebar-section'>
                            <button type="button" class='sidebar-section-title'>
                                {section.icon && <i class={`${section.icon} fa-fw`}></i>}
                                {t(section.titleKey, locale)}
                                <i class='fas fa-chevron-down sidebar-chevron' aria-hidden="true"></i>
                            </button>
                            <div class={`sidebar-nav sidebar-collapsible${defaultCollapsed ? ' collapsed' : ''}`}>
                                {
                                    sorted.map(page => {
                                        return (
                                            <a href={getWikiUrl(page.id, locale)} aria-current={getWikiUrl(page.id, locale) === currentPath ? 'page' : undefined} class='sidebar-nav-title'>
                                                <i class='far fa-file-lines fa-fw'></i>
                                                {page.data.title}
                                            </a>
                                        )
                                    })
                                }
                            </div>
                        </section>
                    );
                } else if (section.items) {
                    return (
                        <section class='sidebar-section'>
                            <button type="button" class='sidebar-section-title'>
                                {section.icon && <i class={`${section.icon} fa-fw`}></i>}
                                {t(section.titleKey, locale)}
                                <i class='fas fa-chevron-down sidebar-chevron' aria-hidden="true"></i>
                            </button>
                            <div class={`sidebar-nav sidebar-collapsible${defaultCollapsed ? ' collapsed' : ''}`}>
                                {section.items.map(item => {
                                    let href = item.path;
                                    let label = item.i18nKey ? t(item.i18nKey, locale): '';
                                    if (!item.external) {
                                        const key = normalizeSlugLike(item.path.replace(/^\/+|\/+$/g, ''));
                                        const page = key ? slugMap[key] : undefined;
                                        if (page) {
                                            href = getWikiUrl(page.id, locale);
                                            if (!item.i18nKey) label = page.data.title;
                                        } else {
                                            href = item.path === '/' ? localeBaseUrl : `${localeBaseUrl}${item.path}`;
                                        }
                                    }
                                    if (!href || !label) {
                                        return null;
                                    }
                                    return <a href={href} rel={item.external ? 'noopener noreferrer' :null} aria-current={!item.external && isPathActive(item.path, currentPath) ? 'page' : undefined}>
                                        {item.icon
                                            ? <i class={`${item.icon} fa-fw`}></i>
                                            : <i class='far fa-file-lines fa-fw'></i>
                                        }
                                        {' '}
                                        {label}
                                    </a>
                                })}
                            </div>
                        </section>
                    );
                } else {
                    return null;
                }
            })
        }

        {autoAddUnknownCategories && Object.entries(pagesByCategory).map(([category, categoryPages]) => {
            if (renderedCategories.has(category)) {
                return null;
            }
            const sorted = [...categoryPages].sort(
                (a, b) => a.data.title.localeCompare(b.data.title)
            );
            return (
                <section class='sidebar-section'>
                    <button type="button" class='sidebar-section-title'>
                        <i class='fas fa-folder fa-fw' aria-hidden="true"></i>
                        {category === ''
                            ? t('homepage.title', locale)
                            : t(`category.${category}` as TranslationKey, locale)
                        }
                        <i class='fas fa-chevron-down sidebar-chevron' aria-hidden="true"></i>
                    </button>
                    <div class='sidebar-nav'>
                        {sorted.map((page) => {
                            return (
                                <a href={getWikiUrl(page.id, locale)} aria-current={getWikiUrl(page.id, locale) === currentPath ? 'page' : undefined}>
                                    <i class='far fa-file-lines fa-fw'></i>
                                    {page.data.title}
                                </a>
                            )
                        })}
                    </div>
                </section>
            )
        })}
    </nav>
</aside>