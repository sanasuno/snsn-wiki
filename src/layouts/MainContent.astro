---
/**
 * @layouts/MainContent.astro
 * メインコンテンツレイアウト
 */
import { getEntry } from 'astro:content';
import { t, type Locale } from '@lib/i18n';
import { ensureTrailingSlash, removeTrailingSlash, getLocaleBaseUrl, getWikiBaseUrl, getWikiUrl, getCurrentPath, getLocalePathUrl } from '@lib/path';
import { getCategory, getCategoryArray, getTranslatedCategory, translateCategory } from '@lib/category';
import { formatDate } from '@lib/date';

interface Props {
    title: string;
    locale: Locale;
    type: 'wiki' | 'category' | 'tag' | 'other';
    tags?: string[];
    date?: Date;
    updated?: Date;
    id?: string;
    isSubpage?: boolean;
    isFallback?: boolean;
    fallbackLocale?: Locale;
}

const {
    title,
    locale,
    type,
    tags = [],
    date,
    updated,
    id,
    isSubpage = false,
    isFallback = false,
    fallbackLocale,
} = Astro.props;

const localeBaseUrl = getLocaleBaseUrl(locale);
const wikiBaseUrl = getWikiBaseUrl(locale);

type Crumb = {
    kind: 'home' | 'category' | 'page';
    label: string;
    href: string;
}

const isWikiRoot = (type === 'wiki' && id) ? getCategoryArray(id, isSubpage).length === 0 : false;

const categoryCrumbs: Crumb[] = id
    ? getCategoryArray(id, isSubpage).map((path) => ({
        kind: 'category',
        label: translateCategory(path, locale),
        href: ensureTrailingSlash(`${localeBaseUrl}category/${path}`),
    }))
    : [];

const crumbs: Crumb[] = [
    {
        kind: 'home',
        label: t('homepage.title', locale),
        href: ensureTrailingSlash(wikiBaseUrl)
    },
    ...categoryCrumbs,
    ...(isWikiRoot ? [] : [{ kind: 'page', label: title, href: '' } as Crumb]),
];
const crumbIcons = {
    home: 'fas fa-house',
    category: 'fas fa-folder',
    page: 'far fa-file',
}

const currentPath = getCurrentPath(Astro.url);

const categoryString = id ? getCategory(id, isSubpage) : '';
const parts = removeTrailingSlash(currentPath).split('/');
const parentHref = ensureTrailingSlash(parts.slice(0, -1).join('/'));
const parentLabel = type === 'wiki'
    ? (await getEntry('wiki', `${locale}/${categoryString}`))?.data.title
    : type === 'category'
        ? translateCategory(id?.split('/').slice(0, -1).join('/') ?? '', locale) || t('categorypage.title', locale)
        : type === 'tag'
            ? t('tagpage.title', locale)
            : '';
---
<main class="main-content" id="main-content">
    {isFallback && (
        <div class="fallback-notice" role="note">
            <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
            <span>{t('fallback.notice', locale)}</span>
        </div>
    )}
    <header class="page-header">
        {type === 'wiki' && (
            <nav class="breadcrumb">
                <ol class="breadcrumbs">
                    {crumbs.map((crumb, index) => {
                        const isLast = index === crumbs.length -1;
                        return (
                            <>
                                <li class:list={{ 'breadcrumb__current': isLast}} aria-current={isLast ? 'page' : undefined}>
                                    <i class={crumbIcons[crumb.kind]} aria-hidden="true"></i>
                                    {crumb.href && !isLast
                                        ? <a href={crumb.href}>{crumb.label}</a>
                                        : <span>{crumb.label}</span>
                                    }
                                </li>
                                {!isLast && (
                                    <li class="breadcrumb__separator" aria-hidden="true">
                                        <i class="fas fa-chevron-right"></i>
                                    </li>
                                )}
                            </>
                        );
                    })}
                </ol>
            </nav>
        )}
        <h1 class="page-title" lang={isFallback ? fallbackLocale : locale}>
            {title}
        </h1>
        {isSubpage && (
            <div class="subpage-back">
                <a href={parentHref}>
                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                    {parentLabel}
                </a>
            </div>
        )}
        {((type === 'wiki' && id) || date || updated) && (
            <div class="page-meta">
                {(type === 'wiki' && id) && (
                    <div class="page-meta-category">
                        <a href={ensureTrailingSlash(`${localeBaseUrl}category/${categoryString}`)}>
                            {
                                isWikiRoot
                                    ? t('meta.nocategory', locale)
                                    : getTranslatedCategory(id, locale, isSubpage)
                            }
                        </a>
                    </div>
                )}
                {( date || updated) && (
                    <div class="page-meta-dates">
                        {date && (
                            <span class="page-date">
                                <i class="far fa-calendar-plus" aria-hidden="true"></i>
                                {t('meta.created', locale)}: {formatDate(date, locale)}
                            </span>
                        )}
                        {updated && (
                            <span class="page-date">
                                <i class="fas fa-clock-rotate-left" aria-hidden="true"></i>
                                {t('meta.updated', locale)}: {formatDate(updated, locale)}
                            </span>
                        )}
                    </div>
                )}
            </div>
        )}
    </header>
    <article class="article-content" lang={isFallback ? fallbackLocale : locale}>
        <slot />
        {tags.length > 0 && (
            <div class="page-tags">
                {tags.map(tag => (
                    <a href={getLocalePathUrl(locale, `tag/${tag}/`)} class="page-tag">
                        #{tag}
                    </a>
                ))}
            </div>
        )}
    </article>
</main>