---
/**
 * @layouts/MainContent.astro
 * メインコンテンツレイアウト
 */
import { t, type Locale } from '@i18n/i18n.config';
import { ensureTrailingSlash, getLocaleBaseUrl, getWikiBaseUrl, getCurrentPath, getLocalePathUrl } from '@lib/path';
import { getCategory, getCategoryString, getTranslatedCategory } from '@lib/category';
import { formatDate } from '@lib/date';

interface Props {
    title: string;
    locale: Locale;
    tags?: string[];
    date?: Date;
    updated?: Date;
    id?: string;
    isSubPage?: boolean;
    isFallback?: boolean;
}

const {
    title,
    locale,
    tags = [],
    date,
    updated,
    id,
    isSubPage = false,
    isFallback = false,
} = Astro.props;

const localeBaseUrl = getLocaleBaseUrl(locale);
const wikiBaseUrl = getWikiBaseUrl(locale);

const currentPath = getCurrentPath(Astro.url);

const categoryString = id ? getCategoryString(id, isSubPage) : '';

type Crumb = {
    kind: 'home' | 'category' | 'page';
    label: string;
    href: string;
}

const categoryLabel = id ? getTranslatedCategory(id, locale, isSubPage) : '';
const isWikiRoot = id ? getCategory(id, isSubPage).length === 0 : false;

const crumbs: Crumb[] = [
    {
        kind: 'home',
        label: t('homepage.title', locale),
        href: ensureTrailingSlash(wikiBaseUrl)
    },
    ...(categoryLabel ? [{ kind: 'category', label: categoryLabel } as Crumb] : []),
    ...(isWikiRoot ? [] : [{ kind: 'page', label: title } as Crumb]),
];
const crumbIcons = {
    home: 'fas fa-house',
    category: 'fas fa-folder',
    page: 'far fa-file',
}
---
<div class="main-content" id="main-content">
    {isFallback && (
        <div class="fallback-notice" role="note">
            <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
            <span>{t('fallback.notice', locale)}</span>
        </div>
    )}
    <header class="page-header">
        {id && (
            <nav class="breadcrumb">
                <ol class="breadcrumbs">
                    {crumbs.map((crumb, index) => {
                        const isLast = index === crumbs.length -1;
                        return (
                            <>
                                <li class:list={{ 'breadcrumb__current': isLast}} aria-current={isLast ? 'page' : undefined}>
                                    <i class={crumbIcons[crumb.kind]} aria-hidden="true"></i>
                                    {crumb.href && !isLast
                                        ? <a href={crumb.href}>{crumb.label}</a>
                                        : <span>{crumb.label}</span>
                                    }
                                </li>
                                {!isLast && (
                                    <li class="breadcrumb__separator" aria-hidden="true">
                                        <i class="fas fa-chevron-right"></i>
                                    </li>
                                )}
                            </>
                        );
                    })}
                </ol>
            </nav>
        )}
        <h1 class="page-title">
            {title}
        </h1>
        {(id || date || updated) && (
            <div class="page-meta">
                {id && (
                    <div class="page-meta-category">
                        <a href={`${localeBaseUrl}category/${categoryString}`}>
                            {getTranslatedCategory(id, locale, isSubPage)}
                        </a>
                    </div>
                )}
                {( date || updated) && (
                    <div class="page-meta-dates">
                        {date && (
                            <span class="page-date">
                                <i class="far fa-calendar-plus" aria-hidden="true"></i>
                                {t('meta.created', locale)}: {formatDate(date, locale)}
                            </span>
                        )}
                        {updated && (
                            <span class="page-date">
                                <i class="fas fa-clock-rotate-left" aria-hidden="true"></i>
                                {t('meta.updated', locale)}: {formatDate(updated, locale)}
                            </span>
                        )}
                    </div>
                )}
            </div>
        )}
    </header>
    <article class="article-content">
        <slot />
        {tags.length > 0 && (
            <div class="page-tags">
                {tags.map(tag => (
                    <a href={getLocalePathUrl(locale, `tag/${tag}`)} class="page-tag">
                        #{tag}
                    </a>
                ))}
            </div>
        )}
    </article>
</div>