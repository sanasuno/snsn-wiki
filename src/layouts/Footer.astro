---
/**
 * @layouts/Footer.astro
 * フッターコンポーネント
 */
import { t, type Locale } from '@i18n/i18n.config';
import { getLocaleBaseUrl, getLocalePathUrl } from '@lib/path';
import { footerNavItems } from '@layouts/footer.nav';

interface Props {
    locale: Locale,
}
const { locale } = Astro.props;
const localeBaseUrl = getLocaleBaseUrl(locale);

const startYear = 2026;

const year = new Date().getFullYear();
---
<footer class="site-footer">
    <div class="site-footer-links">
        {footerNavItems.map((item) => (
            <a href={getLocalePathUrl(locale, item.path)}>{t(item.i18nKey, locale)}</a>
        ))}
    </div>
    <div class="site-footer-credit">
        © {startYear === year ? startYear : `${startYear} - ${year}`} {t('site.title', locale)}.
    </div>
</footer>