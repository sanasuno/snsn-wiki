---
/**
 * @layouts/Footer.astro
 * フッターコンポーネント
 */
import { t, type Locale } from '@lib/i18n';
import { getLocalePathUrl } from '@lib/path';
import { footerNavItems } from '@layouts/footer.nav';
import { siteConfig } from '../site.config';

interface Props {
    locale: Locale,
}
const { locale } = Astro.props;

const startYear = siteConfig.startYear;

const year = new Date().getFullYear();
---
<footer class="site-footer">
    <div class="site-footer-links">
        {footerNavItems.map((item) => (
            <a href={getLocalePathUrl(locale, item.path)}>
                {t(item.i18nKey, locale)}
            </a>
        ))}
    </div>
    <div class="site-footer-credit">
        © {startYear === year ? startYear : `${startYear} - ${year}`} {t('site.title', locale)}.
    </div>
</footer>