---
/**
 * @layouts/Footer.astro
 * フッターコンポーネント
 */
import { t, type Locale } from '@i18n/i18n.config';
import { getLocaleBaseUrl } from '@lib/path';

interface Props {
    locale: Locale,
}
const { locale } = Astro.props;
const localeBaseUrl = getLocaleBaseUrl(locale);

const startYear = 2026;

const year = new Date().getFullYear();
---
<footer class="site-footer">
    <div class="site-footer-links">
        <a href={`${localeBaseUrl}/privacy/`}>{t('privacy.title', locale)}</a>
        <a href={`${localeBaseUrl}/terms/`}>{t('terms.title', locale)}</a>
    </div>
    <div class="site-footer-credit">
        © {startYear === year ? startYear : `${startYear} - ${year}`} {t('site.title', locale)}.
    </div>
</footer>