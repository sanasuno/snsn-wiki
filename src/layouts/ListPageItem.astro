---
/**
 * @components/ListPageItem.astro
 * 一覧ページ用のページ項目
 */
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@lib/i18n';
import { getWikiUrl, getTagUrl } from '@lib/path';
import { formatDate } from '@lib/date';

interface Props {
    page: CollectionEntry<'wiki'>;
    locale: Locale;
}
const { page, locale } = Astro.props;
const { title, description, tags, date, updated } = page.data;
const shown = updated ?? date;
---
<li class="listpage-item">
    <div class="listpage-item-left">
        <div class="listpage-item-content">
            <a href={getWikiUrl(page.id, locale)} class="listpage-item-title">
                <i class="far fa-file-lines" aria-hidden="true"></i>
                {title}
            </a>
            {tags.length > 0 && (
                <div class="listpage-item-tags">
                    {tags.map((tag) => (
                        <a href={getTagUrl(locale, tag)} class="listpage-item-tag">#{tag}</a>
                    ))}
                </div>
            )}
        </div>
        {description && <p class="listpage-item-description">{description}</p>}
    </div>
    {shown && (
        <div class="listpage-item-right">
            <p class="listpage-item-updated">
                <i class={updated ? 'fas fa-clock-rotate-left' : 'far fa-calendar-plus'} aria-hidden="true"></i>
                {formatDate(shown, locale)}
            </p>
        </div>
    )}
</li>