---
/**
 * @layouts/Toc
 * 目次レイアウト
 */
import { t, type Locale } from '@i18n/i18n.config';

interface Props {
    headings: Array<{
        slug: string;
        depth: number;
        text: string;
    }>;
    locale: Locale;
}

const { headings, locale } = Astro.props;

const filtered = headings.filter(h => h.depth >= 2 && h.depth <= 4);
---
{filtered.length > 0 && (
    <nav aria-label={t('toc.title', locale)}>
        <div class="toc-title">
            <i class="fas fa-list-ul" aria-hidden="true"></i>
            {t('toc.title', locale)}
        </div>
        <ol class="toc-nav">
            {filtered.map(heading => (
                <li class={`depth-${heading.depth}`}>
                    <a href={`#${heading.slug}`}>
                        {heading.text}
                    </a>
                </li>
            ))}
        </ol>
    </nav>
)}